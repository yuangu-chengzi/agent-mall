# waynboot-agent 配置样例
# 复制为 .env 后按需修改；.env 不入库（含 API Key）。

# --- 服务自身 ---
AGENT_HOST=0.0.0.0
AGENT_PORT=8300
AGENT_LOG_LEVEL=INFO

# --- mall（waynboot-mobile-api）---
AGENT_MALL_BASE_URL=http://localhost:82
AGENT_MALL_TIMEOUT_SECONDS=10

# --- LLM（DeepSeek，OpenAI 兼容接口）---
AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
# 留空则回退读系统环境变量 DEEPSEEK_API_KEY（推荐：密钥不进仓库）
# 可用模型以 GET {base_url}/models 为准，当前为 deepseek-flash / deepseek-v4-pro
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=deepseek-flash
AGENT_LLM_TIMEOUT_SECONDS=30

# --- Agent 循环上限（recursion_limit，一次工具调用消耗 2 步，16 ≈ 8 轮工具调用）---
AGENT_GRAPH_RECURSION_LIMIT=16

# --- 每轮最多发给 LLM 的历史消息条数（0 = 不限；防长对话 token 成本线性上涨）---
AGENT_HISTORY_MAX_MESSAGES=24

# --- Agent 自身访问令牌（可选，留空=不启用）：非空时 /api/* 需带 X-Agent-Token ---
AGENT_ACCESS_TOKEN=

# --- Redis（复用 mall 的 Redis，独立 key 前缀）---
AGENT_REDIS_URL=redis://localhost:6379/0
AGENT_REDIS_KEY_PREFIX=waynboot:agent:
AGENT_SESSION_TTL_SECONDS=86400

# --- 限流与配额（按用户身份计数：登录用户按 token 哈希，匿名按 IP）---
AGENT_RATE_LIMIT_QPS=3
AGENT_RATE_LIMIT_DAILY=300
